[Unit]
Description=OmniRoute LLM gateway for dsh and SSSF (loopback, reachable over Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target
# A misconfiguration should surface as a stopped unit, not a hot restart loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Secrets and storage live in ~/.omniroute; the working directory only matters
# for relative paths OmniRoute itself might resolve.
WorkingDirectory=@@HOME@@/.omniroute
Environment=PATH=@@PATH@@
# The default binds 0.0.0.0 with no API key required, offering /v1/* to the LAN.
# Tailscale Serve reaches it on loopback instead.
Environment=OMNIROUTE_SERVER_HOST=127.0.0.1
# The defaults shed real agent work: a 15s queue wait kills browser-bridge
# providers, and only ONE heavy request may run at once, so a second concurrent
# dsh/pi/fusion caller gets 503 chat_admission_busy instead of queuing.
Environment=RATE_LIMIT_MAX_WAIT_MS=600000
Environment=OMNIROUTE_CHAT_MAX_HEAVY_IN_FLIGHT=6
Environment=OMNIROUTE_CHAT_ADMISSION_QUEUE_MS=15000
ExecStart=@@NODE@@ @@OMNIROUTE_BIN@@ serve --port @@OMNIROUTE_PORT@@ --no-open --no-tray
# OmniRoute runs its own crash-recovery supervisor; systemd is the backstop
# when that gives up. SIGTERM is its clean shutdown (checkpoints SQLite).
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
