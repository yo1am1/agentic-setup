[Unit]
Description=SSLF life factory API (Fastify, built from apps/api)
# A misconfiguration should surface as a stopped unit, not a hot restart loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# The API resolves data.json and .env relative to its own module, so the
# working directory is only for anything it spawns.
WorkingDirectory=@@SSLF_ROOT@@/apps/api
Environment=PORT=@@SSLF_API_PORT@@
# Loopback only: the web app proxies /api, and only the web port is published.
Environment=HOST=127.0.0.1
Environment=PATH=@@PATH@@
# The built output, not `tsx watch`: a dev watcher per surface is what exhausted
# the inotify limit and took the dsh web UI down with ENOSPC. `just go` builds first.
ExecStart=@@NODE@@ @@SSLF_ROOT@@/apps/api/dist/index.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
