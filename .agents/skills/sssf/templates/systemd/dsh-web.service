[Unit]
Description=DeepSeek Harness web UI (loopback, reachable over Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target
# A misconfiguration should surface as a stopped unit, not a hot restart loop.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Deliberately the home directory, not the factory `just go` ran in. Browser
# sessions choose their own project in the UI, so this is only a default — and
# following the invocation directory made it a liability twice over: the unit
# was rewritten on every `just go` from a different repo, and dsh refuses to
# boot at all in a directory whose `.env` sets a code-loading variable such as
# PYTHONPATH, which is a perfectly ordinary thing for a Python repo to do.
WorkingDirectory=@@HOME@@
Environment=DSH_WEB_PORT=@@DSH_PORT@@
Environment=PATH=@@PATH@@
# --host stays at the composed default (loopback): binding all interfaces would
# hand the UI to the LAN as well, and Tailscale Serve does not need it. The
# tailnet name arrives in the Host header instead, so it has to be named as a
# trusted authority — the same list the visualizer's fence gets, same script.
# --no-open because there is no desktop session to open a browser in.
#
# Every `$` below is written `$$`: systemd expands its own specifiers in
# ExecStart before the shell ever runs, and it turned `${args[@]}` into an empty
# string, which reached dsh as a stray bare argument.
ExecStart=/bin/bash -c 'args=(); while read -r authority; do args+=(--trusted-host "$$authority"); done < <(bash @@AUTHORITIES@@ "$$DSH_WEB_PORT"); exec @@DSH@@ --profile web --no-open --port "$$DSH_WEB_PORT" "$${args[@]}"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
