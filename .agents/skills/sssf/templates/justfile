# SSSF — one shared engine, linked into every factory. The web app owns workflow selection.
set dotenv-load
set positional-arguments

sssf := home_directory() / ".claude/skills/sssf"
# SSLF, the life factory, is its own checkout; services.py reads the same variable.
sslf := env("SSLF_ROOT", home_directory() / "VS/factories/sslf")

_default: help

# show the available commands
help:
    @just --list --unsorted

# rebuild both web apps (SSSF and SSLF) and apply them to whatever is already running
rebuild: build-sssf build-sslf
    # The browser reads dist/ per request, so the client is already live — but a
    # change under server/ is only picked up by restarting the process, and one
    # command has to mean "my changes are running".
    uv run "{{sssf}}/scripts/services.py" reload

[private]
build-sssf:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v bun >/dev/null || { echo "bun is required: https://bun.sh/docs/installation" >&2; exit 127; }
    cd "{{sssf}}/apps/visualizer"
    bun install --frozen-lockfile
    bun run build

[private]
build-sslf:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v npm >/dev/null || { echo "npm (Node.js 22+) is required to build SSLF" >&2; exit 127; }
    [ -f "{{sslf}}/package.json" ] || { echo "no SSLF checkout at {{sslf}} — set SSLF_ROOT" >&2; exit 1; }
    cd "{{sslf}}"
    # `install`, not `ci`: ci deletes node_modules on every run, and `go` runs often.
    npm install --no-audit --no-fund --loglevel=error
    npm run build

# link this repo's SSSF machinery to the shared software-factory
init *ARGS:
    cd "{{invocation_directory()}}" && uv run "{{sssf}}/scripts/install.py" "$@"

# unlink this repo from the shared software-factory (--purge also drops its trace)
remove *ARGS:
    cd "{{invocation_directory()}}" && uv run "{{sssf}}/scripts/uninstall.py" "$@"

# rebuild, then serve SSSF, SSLF, dsh and OmniRoute — on your tailnet if it is up
go: rebuild
    cd "{{invocation_directory()}}" && uv run "{{sssf}}/scripts/services.py" up

# read one run's trace: phase, status, duration, tool calls (the banner points here)
phases ADW_ID:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v sqlite3 >/dev/null || { echo "sqlite3 is required to read the trace" >&2; exit 127; }
    db="{{invocation_directory()}}/adws/adw_data/sssf.db"
    [ -f "$db" ] || { echo "no trace db at $db — has an ADW run in this repo yet?" >&2; exit 1; }
    # Tool calls and minutes side by side is the view that matters: a step whose
    # cost is a tool loop rather than reasoning is invisible in totals alone,
    # and that is exactly how a 94-minute synthesis hid inside a passing run.
    sqlite3 -header -column "$db" "
      select p.seq, p.name, p.owner, p.status,
             round((julianday(p.ended_at)-julianday(p.started_at))*1440, 1) as minutes,
             (select count(*) from events e
               where e.phase_id = p.phase_id and e.type = 'tool_call') as tool_calls,
             coalesce(p.error, '') as error
        from phases p where p.adw_id = '{{ADW_ID}}' order by p.seq;"
    sqlite3 -header -column "$db" "
      select status, total_tokens, round(total_cost, 4) as cost, engineer
        from sessions where adw_id = '{{ADW_ID}}';"

# where every surface is, and whether the tailnet can reach it
status:
    @uv run "{{sssf}}/scripts/services.py" status

# the current, ready-to-click dsh web URL — dsh mints a fresh token every boot
dsh-url:
    @uv run "{{sssf}}/scripts/services.py" dsh-url

# follow every surface's logs
logs:
    @journalctl --user -u sssf-visualizer -u dsh-web -u sslf-api -u sslf-web -u omniroute -f --output=cat

# stop every surface
kill:
    @uv run "{{sssf}}/scripts/services.py" down
